<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>

        <!-- Date and time picker themes -->
        <item name="android:datePickerDialogTheme">@style/Dialog.Theme</item>
        <item name="android:timePickerDialogTheme">@style/Dialog.Theme</item>

        <!-- Android navigation bar 1C571C -->
        <item name="android:navigationBarColor">#003c04</item>
        <item name="android:windowLightNavigationBar">false</item>

    </style>

    <!-- Configuration for Dialog theme -->
    <style name="Dialog.Theme" parent="Theme.AppCompat.Light.Dialog">

        <item name="colorAccent">#003c04</item>

    </style>

</resources>


